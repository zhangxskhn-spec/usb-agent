# ============================================
#  U 盘 AI 助手（便携版）- 忽略规则
# ============================================

# ---------- 便携运行时 ----------
# runtime/ 约 1.6 GB（内置 Node + CloudCLI + Git），克隆后需按 README 补齐，不入库
runtime/
tools/node_modules/
**/__pycache__/
*.py[cod]

# ---------- 运行时产生的用户数据与状态 ----------
# data/ 含浏览器 profile、会话、记忆、日志等本机状态，不入库
data/

# ---------- 机密 ----------
# 真实 API Key 只存在本地；仓库中提供 config/keys.env.example 作为模板
config/keys.env
# 本机免登录 JWT（由本机 auth.db 签发），构建时注入，不入库
config/local-token.txt

# ---------- 本地工具缓存 ----------
.workbuddy/

# ---------- 日志 ----------
*.log

# ---------- 系统文件 ----------
Thumbs.db
.DS_Store
desktop.ini

# ---------- 工作区里的临时脚本（Claude 的工作目录，不入库）----------
workspace/*.ps1
workspace/*.tmp
