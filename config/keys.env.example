# ============================================
#  U-Disk AI Assistant  -  keys & models
#  复制本文件为 keys.env 后填入真实密钥：
#     copy config\keys.env.example config\keys.env
#  keys.env 已在 .gitignore 中，不会被提交。
#  修改后下次启动生效。
# ============================================

# --- MiMo（小米）---
# 申请地址见 https://xiaomi.com  （模型广场 / API）
MIMO_API_KEY=
MIMO_MODEL=mimo-v2.6-flash

# --- 默认模型（网页端选「默认」/ 终端版启动时用；可改成任意有效模型 id）---
DEFAULT_MODEL=mimo-v2.6-flash

# --- DeepSeek ---
# get one at https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_MODEL=deepseek-v4-pro
